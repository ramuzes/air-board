# AirBoard configuration — copy to .env and edit.
# bun loads .env automatically on every start; no flags needed.
# .env is git-ignored (it holds secrets).

# Port to listen on (default 3000)
PORT=3000

# SQLite database file, created if missing (default ./airboard.db)
DB_PATH=./airboard.db

# Base URL agents see in /api/agents/instructions (default http://localhost:3000)
BASE_URL=http://localhost:3000

# Shared secret for the GitLab webhook (X-Gitlab-Token). Required for
# /api/plugins/gitlab/webhook to work; until set it answers 503 NOT_CONFIGURED.
GITLAB_WEBHOOK_SECRET=
